# Server
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# PostgreSQL (docker compose — see README)
PGHOST=localhost
PGPORT=5432
PGDATABASE=legends_booking
PGUSER=postgres
PGPASSWORD=postgres
# Maintenance DB used only to auto-create PGDATABASE (default: postgres)
# PGADMIN_DATABASE=postgres

# Optional defaults for `npm run seed`
# ADMIN_NAME=Gym Owner
# ADMIN_EMAIL=admin@legends.local
# ADMIN_PASSWORD=changeme123
